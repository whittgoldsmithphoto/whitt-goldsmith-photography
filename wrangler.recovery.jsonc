{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wgp-payment-recovery-staging",
  "main": "src/payment-recovery-worker.ts",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "triggers": { "crons": ["*/5 * * * *"] },
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "c9d803e0e964401298a952b85dd05af4" }],
  "vars": {
    "CATALOG_ENV": "staging",
    "CATALOG_RECOVERY_ENABLED": "false",
    "CATALOG_STRIPE_ACCOUNT_ID": "acct_1UBQ7DDHsmsdTdeg"
  }
}
